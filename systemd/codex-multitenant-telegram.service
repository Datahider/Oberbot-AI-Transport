[Unit]
Description=Codex Multitenant Telegram Transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexgate-webhook
WorkingDirectory=/home/codexgate-webhook/htdocs/webhook.codexgate.ru
Environment=HOME=/home/codexgate-webhook
Environment=COMPOSER_HOME=/home/codexgate-webhook/.composer
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env php8.5 /home/codexgate-webhook/htdocs/webhook.codexgate.ru/bin/telegram-transport.php /home/codexgate-webhook/htdocs/webhook.codexgate.ru/etc/config.php
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
